{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rilisin",
  "main": ".open-next/worker.js",
  // nodejs_compat: node:crypto/zlib/stream dipakai app. Tanggal kompatibilitas wajib >= 2025-05-05 (FinalizationRegistry).
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Output OpenNext sudah di-minify, tapi wrangler membundel ulang tanpa minify (ukuran mentah membengkak ~30%).
  "minify": true,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Normalisasi gambar upload (sharp tidak jalan di workerd). Lihat src/lib/image.ts.
  // Penyimpanan file (STORAGE_DRIVER=r2). Bucket dibuat sekali: wrangler r2 bucket create rilisin-files.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "rilisin-files" }],
  "images": { "binding": "IMAGES" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "rilisin" }],
  "observability": { "enabled": true }
}
