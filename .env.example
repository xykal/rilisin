# Salin file ini jadi .env.local lalu isi nilainya.

# Koneksi PostgreSQL.
#  - Lokal: postgres://rilisin:rilisin@localhost:5432/rilisin
#  - Production (Supabase): pakai connection string "Transaction pooler" dari dashboard Supabase
DATABASE_URL=

# Rahasia untuk menandatangani token upload/download. Minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Penyimpanan file: "local" (development) atau "vercel-blob" (produksi gratis di Vercel).
#   vercel-blob butuh 2 store: PUBLIK (gambar) → BLOB_READ_WRITE_TOKEN, PRIVAT (file aplikasi) → FILES_READ_WRITE_TOKEN
#   (otomatis terisi kalau store dihubungkan ke project Vercel; store privat pakai prefix env "FILES_")
STORAGE_DRIVER=local
# BLOB_READ_WRITE_TOKEN=
# FILES_READ_WRITE_TOKEN=
STORAGE_LOCAL_DIR=.local/storage

# Batas ukuran file rilis (MB)
MAX_RELEASE_FILE_MB=100

# Set "false" kalau menjalankan mode production tanpa HTTPS (misal tes lokal)
# COOKIE_SECURE=true

# Domain tambahan yang boleh memanggil endpoint upload/download (pisahkan koma, boleh wildcard *.).
# Default: *.e2b.app (preview sandbox). Di production isi dengan domain kamu, contoh: rilisin.id
# ALLOWED_ORIGINS=*.e2b.app

# Siapa yang boleh menampilkan situs di dalam iframe (CSP frame-ancestors).
# Kosong = 'none' (disarankan di production, anti clickjacking). Preview sandbox: *
# FRAME_ANCESTORS=

# Admin & moderator wajib 2FA untuk membuka panel moderasi (production: 1)
REQUIRE_STAFF_2FA=1

# Koneksi langsung (bukan pooler) untuk LISTEN/NOTIFY chat realtime. Supabase: "Direct connection"/"Session pooler".
# Kosong = pakai DATABASE_URL.
# DATABASE_URL_DIRECT=

# Jumlah proxy tepercaya di depan app (untuk membaca IP asli dari X-Forwarded-For). Vercel/Cloudflare: 1
# TRUSTED_PROXY_HOPS=1

# ─── Pembayaran (Fase 2) ─────────────────────────────────────────────────────
# mock = simulasi (tanpa uang sungguhan, ada tombol "Simulasikan pembayaran") · pakasir = gateway asli (API v2)
PAYMENT_PROVIDER=mock
# Masa tahan saldo seller (hari) & minimal pencairan (rupiah)
PAYMENT_HOLD_DAYS=7
PAYOUT_MIN_IDR=50000

# Pakasir (https://app.pakasir.com) — buat PROYEK KHUSUS untuk Rilisin (jangan pakai proyek aplikasi lain).
# Webhook URL di pengaturan proyek: https://DOMAINMU/api/payments/pakasir/webhook
PAKASIR_SLUG=
PAKASIR_API_KEY=
# "Webhook Secret" dari bagian bawah halaman detail proyek (dikirim Pakasir sebagai header X-Secret)
PAKASIR_WEBHOOK_SECRET=
# Production live: 0 → transaksi sandbox ditolak. Selama uji coba sandbox: 1
PAKASIR_ALLOW_SANDBOX=1

# URL publik situs (dipakai di email & link). Contoh: https://rilisin.id
APP_URL=http://localhost:3000

# Email via Resend (opsional): struk, notifikasi, reset password. EMAIL_FROM wajib domain yang sudah diverifikasi di Resend.
# Tanpa ini email hanya dicatat di log. Alamat .test/.example/.invalid/.localhost TIDAK pernah dikirim (akun demo).
# RESEND_API_KEY=
# EMAIL_FROM="Rilisin <noreply@domainmu.id>"
# Teks password demo di halaman masuk (staging memakai SEED_DEMO_PASSWORD, jangan tampilkan rilisin123)
# DEMO_PASSWORD_HINT="dibagikan terpisah"

# ─── Keamanan & operasi (Fase 4) ─────────────────────────────────────────────
# Cloudflare Turnstile (captcha tanpa teka-teki) untuk daftar, lupa password & masuk yang mencurigakan.
# Buat widget di https://dash.cloudflare.com → Turnstile (domain widget: domain produksimu).
# Kosong = fitur mati. Kunci uji resmi Cloudflare (selalu lolos): site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# "soft" = token dicek kalau ada, tanpa token tetap lolos — KHUSUS staging yang sudah dikunci Basic Auth.
# Produksi biarkan kosong (= strict).
# TURNSTILE_MODE=

# Token bersama app ↔ worker antivirus (scanner/). Minimal 32 karakter acak:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Tanpa ini endpoint /api/internal/scan/* mati (401) dan pemindaian tidak berjalan.
# SCAN_WORKER_TOKEN=
# File baru boleh diunduh hanya setelah hasil scan bersih (aktifkan setelah worker produksi jalan)
# REQUIRE_CLEAN_SCAN=1
# Lokasi clamd untuk worker (default 127.0.0.1:3310) — diisi di mesin worker, bukan di app
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
# Jendela "worker hidup" di halaman Sistem (menit). Worker selalu-nyala: biarkan default (15).
# Worker terjadwal (cron GitHub Actions / crontab): isi sedikit di atas interval antar-run
# (contoh: 90 untuk jadwal per jam) supaya tidak selalu tampil "mati" di antara run.
# SCAN_WORKER_TTL_MIN=90

# Rahasia pemicu cron harian Vercel (/api/cron/harian: pembersihan + backup). Minimal 16 karakter acak.
# Vercel mengirim header "Authorization: Bearer <CRON_SECRET>" — tanpa env ini endpoint mati (503).
# CRON_SECRET=

# Backup database terenkripsi (X25519 + AES-256-GCM). App hanya memegang KUNCI PUBLIK untuk mengenkripsi;
# kunci privat disimpan offline oleh pemilik (tidak pernah masuk server/repo).
# Buat pasangan: npm run backup:keygen  (scripts/backup-keygen.ts)
# BACKUP_PUBLIC_KEY=
# Pulihkan backup (di mesin operator, bukan di app):
#   BACKUP_PRIVATE_KEY=... npx tsx scripts/backup-restore.ts rilisin-20260929-020000.rlsbak
# RESTORE_ALLOW_REMOTE=hapus-semua-data   # izinkan restore ke database non-lokal

# ─── Deploy / staging ────────────────────────────────────────────────────────
# Kunci seluruh situs dengan HTTP Basic Auth (wajib untuk staging publik — repo & password demo bersifat publik)
# SITE_LOCK_USER=rilisin
# SITE_LOCK_PASSWORD=
# Vercel Hobby: fungsi maks 300 dtk → tutup stream chat realtime sebelum itu (browser menyambung ulang otomatis)
# SSE_MAX_SECONDS=280
# Neon via Vercel mengisi DATABASE_URL (pooler) + DATABASE_URL_UNPOOLED (langsung, dipakai LISTEN chat)
# Seed ke database/storage non-lokal: SEED_ALLOW_REMOTE=hapus-semua-data, password akun demo: SEED_DEMO_PASSWORD
# Smoke test ke staging: SMOKE_BASIC_AUTH="user:password" (kunci situs), SMOKE_DEMO_PASSWORD (= SEED_DEMO_PASSWORD)

# ─── Login Google (OAuth 2.0 + PKCE) ──────────────────────────────────────────
# Isi KEDUA nilai ini untuk menampilkan tombol "Lanjutkan dengan Google". Kosong = fitur mati
# dan tombol tidak dirender (pendaftaran/masuk email tetap jalan normal).
# Buat kredensial di https://console.cloud.google.com → APIs & Services → Credentials →
# OAuth client ID → Web application. WAJIB tambahkan Authorized redirect URI:
#   ${APP_URL}/api/auth/google/callback     (contoh produksi: https://rilisin.id/api/auth/google/callback)
# Jangan pakai client ID milik aplikasi lain, dan jangan commit nilainya ke repo.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Hanya untuk pengujian CI (menunjuk ke server OAuth palsu). Di produksi BIARKAN KOSONG —
# kalau diisi, token Google bisa bocor ke alamat itu. Perlakukan seperti secret.
# GOOGLE_AUTH_URL=
# GOOGLE_TOKEN_URL=
# GOOGLE_USERINFO_URL=

# Push HP (OneSignal Web Push) — panduan: docs/PUSH.md
# NEXT_PUBLIC_ONESIGNAL_APP_ID=... (publik, dari OneSignal Settings → Keys & IDs)
# ONESIGNAL_REST_API_KEY=... (RAHASIA server, JANGAN commit — pasang via Vercel env)
