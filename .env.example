# Salin file ini jadi .env.local lalu isi nilainya.

# Koneksi PostgreSQL.
#  - Lokal: postgres://rilisin:rilisin@localhost:5432/rilisin
#  - Production (Supabase): pakai connection string "Transaction pooler" dari dashboard Supabase
DATABASE_URL=

# Rahasia untuk menandatangani token upload/download. Minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Penyimpanan file: "local" (development) atau "vercel-blob" (produksi gratis di Vercel).
#   vercel-blob butuh 2 store: PUBLIK (gambar) → BLOB_READ_WRITE_TOKEN, PRIVAT (file aplikasi) → FILES_READ_WRITE_TOKEN
#   (otomatis terisi kalau store dihubungkan ke project Vercel; store privat pakai prefix env "FILES_")
STORAGE_DRIVER=local
# BLOB_READ_WRITE_TOKEN=
# FILES_READ_WRITE_TOKEN=
STORAGE_LOCAL_DIR=.local/storage

# Batas ukuran file rilis (MB)
MAX_RELEASE_FILE_MB=100

# Set "false" kalau menjalankan mode production tanpa HTTPS (misal tes lokal)
# COOKIE_SECURE=true

# Domain tambahan yang boleh memanggil endpoint upload/download (pisahkan koma, boleh wildcard *.).
# Default: *.e2b.app (preview sandbox). Di production isi dengan domain kamu, contoh: rilisin.id
# ALLOWED_ORIGINS=*.e2b.app

# Siapa yang boleh menampilkan situs di dalam iframe (CSP frame-ancestors).
# Kosong = 'none' (disarankan di production, anti clickjacking). Preview sandbox: *
# FRAME_ANCESTORS=

# Admin & moderator wajib 2FA untuk membuka panel moderasi (production: 1)
REQUIRE_STAFF_2FA=1

# Koneksi langsung (bukan pooler) untuk LISTEN/NOTIFY chat realtime. Supabase: "Direct connection"/"Session pooler".
# Kosong = pakai DATABASE_URL.
# DATABASE_URL_DIRECT=

# Jumlah proxy tepercaya di depan app (untuk membaca IP asli dari X-Forwarded-For). Vercel/Cloudflare: 1
# TRUSTED_PROXY_HOPS=1

# ─── Pembayaran (Fase 2) ─────────────────────────────────────────────────────
# mock = simulasi (tanpa uang sungguhan, ada tombol "Simulasikan pembayaran") · pakasir = gateway asli (API v2)
PAYMENT_PROVIDER=mock
# Masa tahan saldo seller (hari) & minimal pencairan (rupiah)
PAYMENT_HOLD_DAYS=7
PAYOUT_MIN_IDR=50000

# Pakasir (https://app.pakasir.com) — buat PROYEK KHUSUS untuk Rilisin (jangan pakai proyek aplikasi lain).
# Webhook URL di pengaturan proyek: https://DOMAINMU/api/payments/pakasir/webhook
PAKASIR_SLUG=
PAKASIR_API_KEY=
# "Webhook Secret" dari bagian bawah halaman detail proyek (dikirim Pakasir sebagai header X-Secret)
PAKASIR_WEBHOOK_SECRET=
# Production live: 0 → transaksi sandbox ditolak. Selama uji coba sandbox: 1
PAKASIR_ALLOW_SANDBOX=1

# URL publik situs (dipakai di email & link). Contoh: https://rilisin.id
APP_URL=http://localhost:3000

# Email transaksional via Resend (opsional). EMAIL_FROM wajib domain yang sudah diverifikasi di Resend.
# RESEND_API_KEY=
# EMAIL_FROM="Rilisin <noreply@domainmu.id>"

# ─── Deploy / staging ────────────────────────────────────────────────────────
# Kunci seluruh situs dengan HTTP Basic Auth (wajib untuk staging publik — repo & password demo bersifat publik)
# SITE_LOCK_USER=rilisin
# SITE_LOCK_PASSWORD=
# Vercel Hobby: fungsi maks 300 dtk → tutup stream chat realtime sebelum itu (browser menyambung ulang otomatis)
# SSE_MAX_SECONDS=280
# Neon via Vercel mengisi DATABASE_URL (pooler) + DATABASE_URL_UNPOOLED (langsung, dipakai LISTEN chat)
# Seed ke database/storage non-lokal: SEED_ALLOW_REMOTE=hapus-semua-data, password akun demo: SEED_DEMO_PASSWORD
# Smoke test ke staging: SMOKE_BASIC_AUTH="user:password" (kunci situs), SMOKE_DEMO_PASSWORD (= SEED_DEMO_PASSWORD)
